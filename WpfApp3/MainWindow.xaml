<Window x:Class="MusicPlayer.UIComponents.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer.UIComponents" xmlns:convertor="clr-namespace:MusicPlayer.UIComponents.Convertor" xmlns:viewmodels="clr-namespace:MusicPlayer.UIComponents.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize"
        Closed="Window_Closed"
        d:DataContext="{d:DesignInstance viewmodels:MainWindowViewModel}"
        AllowsTransparency="True" Background="Transparent"
        Icon="/Icons/AppIcon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Convertor -->
        <convertor:DurationToDisplayTimeConvertor x:Key="DurationDisplayConverter"/>
        <convertor:IndexConvertor x:Key="IndexConvertor"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    
    <!-- Main Grid -->
    
    <Grid Name="grdMainWindow" Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <!-- Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="130"/>
            <!-- Music Control Bar -->
        </Grid.RowDefinitions>

        <Border Name="bdrWindowContentBackground" Grid.ColumnSpan="3" Grid.RowSpan="3" 
                Background="{Binding CurrentTheme.WindowContentBackground.Brush}" 
                CornerRadius="15"/>

        <!-- Row 1 Main View -->
        
        <Grid Name="grdMainView" Grid.Row="1" Margin="10, 0, 10, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="295"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <!-- Column 0 Left Side Panel -->
            
            <DockPanel Name="dpLeftPanel" LastChildFill="True" Grid.Column="0" Grid.Row="1" Margin="20, 25, 15, 15">
                
                <StackPanel x:Name="ToggleGroup" DockPanel.Dock="Top">

                    <!-- Current Theme Name -->
                    <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 5" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CurrentTheme.Name}" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10.1" Foreground="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}"></TextBlock>
                    </StackPanel>

                    <!-- LOGO -->
                    <StackPanel x:Name="spLogo" Orientation="Horizontal">
                        <Path Data="M72 12 A24 24 0 0 0 48 36 V84 A24 24 0 0 0 72 108 H136 A48 48 0 0 0 136 12 H72 Z" Fill="{Binding CurrentTheme.WindowHeadingForeground.Brush}"  Margin="0, 0, -3, 0" Width="25" Height="25" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="sc" FontStyle="Normal" FontFamily="Lucida Handwriting" FontSize="13" Margin="-18, 4, 0, 5" Foreground="{Binding CurrentTheme.WindowPrimary.Brush}"></TextBlock>
                        <Path Data="M60 20 Q150 150, 60 280 Q90 280, 120 280 Q210 150, 120 20 Z" Fill="{Binding CurrentTheme.WindowHeadingForeground.Brush}"  Margin="0, 0, -8, 0" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <Path Data="M50 20 Q130 150, 50 280 Q70 280, 70 280 Q150 150, 70 20 Z" Fill="{Binding CurrentTheme.WindowHeadingForeground.Brush}"  Margin="0, 0, 0, 0" Width="15" Height="14.8" Stretch="Uniform" VerticalAlignment="Center"/>

                        <TextBlock Text="Spices &amp; Co" FontSize="18.4" FontFamily="Bahnschrift" FontWeight="Bold" Margin="1,0,0,0" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowHeadingForeground.Brush}"></TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="tbHeading2" Text="Home" Margin="0, 40, 0, 0" FontWeight="Bold" FontSize="15" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"></TextBlock>

                    <Border x:Name="bdrAlbums">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                              BlurRadius="2"
                              ShadowDepth="2"
                              Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="btnToggleAlbums"
                           Height="40"
                           Width="180"
                           Checked="ToggleButton_Checked"
                           Margin="0,25,0,0"
                           FontSize="14"
                           FontWeight="Normal"
                           BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                
                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                <Border x:Name="border"
                                             CornerRadius="13"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}">
                                                    <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Content="{TemplateBinding Content}"/>
                                                </Border>
                                                <Path x:Name="pAlbums" Margin="25, 0, 10, 0" Width="16.5" Height="16.5" Stretch="Uniform"
                                                  Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}" HorizontalAlignment="Left"
                                                  Data="M22,4A2,2 0 0,1 24,6V16A2,2 0 0,1 22,18H6A2,2 0 0,1 4,16V4A2,2 0 0,1 6,2H12L14,4H22M2,6V20H20V22H2A2,2 0 0,1 0,20V11H0V6H2M6,6V16H22V6H6Z"/>
                                                    <TextBlock Margin="50, 0, 10, 0" HorizontalAlignment="Left" x:Name="tbAlbums" Text="Dashboard" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                    <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                     Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pAlbums" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbAlbums" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pAlbums" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbAlbums" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                    <TextBlock x:Name="tbHeading3" Text="Productivity" Margin="0, 40, 0, 0" FontWeight="Bold" FontSize="15" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"></TextBlock>

                    <Border x:Name="bdrSongs">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                          BlurRadius="2"
                          ShadowDepth="2"
                          Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="btnToggleSongs"
                           Height="40"
                           Width="180"
                           Checked="ToggleButton_Checked"
                           Margin="0,25,0,0"
                           FontSize="14"
                           BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="border"
                                                     CornerRadius="13"
                                                     Background="{TemplateBinding Background}"
                                                     BorderBrush="{TemplateBinding BorderBrush}">
                                                        <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                    <Path x:Name="pSongs" Margin="25, 0, 10, 0" Width="15" Height="15" Stretch="Uniform"
                                                          Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}" HorizontalAlignment="Left"
                                                          Data="M21,3V15.5A3.5,3.5 0 0,1 17.5,19A3.5,3.5 0 0,1 14,15.5A3.5,3.5 0 0,1 17.5,12C18.04,12 18.55,12.12 19,12.34V6.47L9,8.6V17.5A3.5,3.5 0 0,1 5.5,21A3.5,3.5 0 0,1 2,17.5A3.5,3.5 0 0,1 5.5,14C6.04,14 6.55,14.12 7,14.34V6L21,3Z"/>
                                                    <TextBlock x:Name="tbSongs" Text="Tasks" Margin="50, 0, 10, 0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                        Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pSongs" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbSongs" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pSongs" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbSongs" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                    <Border x:Name="bdrNotes">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                              BlurRadius="2"
                              ShadowDepth="2"
                              Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="btnToggleNotes"
                           Height="40"
                           Width="180"
                           Checked="ToggleButton_Checked"
                           Margin="0,25,0,0"
                           FontSize="14"
                           FontWeight="Normal"
                           BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="border"
                                             CornerRadius="13"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}">
                                                        <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                    <Path x:Name="pNotes" Margin="25, 0, 10, 0" Width="16.5" Height="16.5" Stretch="Uniform"
                                                  Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}" HorizontalAlignment="Left"
                                                  Data="M22,4A2,2 0 0,1 24,6V16A2,2 0 0,1 22,18H6A2,2 0 0,1 4,16V4A2,2 0 0,1 6,2H12L14,4H22M2,6V20H20V22H2A2,2 0 0,1 0,20V11H0V6H2M6,6V16H22V6H6Z"/>
                                                    <TextBlock Margin="50, 0, 10, 0" HorizontalAlignment="Left" x:Name="tbNotes" Text="Notes" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                     Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pNotes" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbNotes" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pNotes" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbNotes" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                    <TextBlock x:Name="tbHeading4" Text="Health &amp; Insights" Margin="0, 40, 0, 0" FontWeight="Bold" FontSize="15" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"></TextBlock>

                    <Border x:Name="bdrWellness">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                          BlurRadius="2"
                          ShadowDepth="2"
                          Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="btnToggleWellness"
                           Height="40"
                           Width="180"
                           Checked="ToggleButton_Checked"
                           Margin="0,25,0,0"
                           FontSize="14"
                           BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="border"
                                                     CornerRadius="13"
                                                     Background="{TemplateBinding Background}"
                                                     BorderBrush="{TemplateBinding BorderBrush}">
                                                        <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                    <Path x:Name="pWellness" Margin="25, 0, 10, 0" Width="15" Height="15" Stretch="Uniform"
                                                          Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}" HorizontalAlignment="Left"
                                                          Data="M21,3V15.5A3.5,3.5 0 0,1 17.5,19A3.5,3.5 0 0,1 14,15.5A3.5,3.5 0 0,1 17.5,12C18.04,12 18.55,12.12 19,12.34V6.47L9,8.6V17.5A3.5,3.5 0 0,1 5.5,21A3.5,3.5 0 0,1 2,17.5A3.5,3.5 0 0,1 5.5,14C6.04,14 6.55,14.12 7,14.34V6L21,3Z"/>
                                                    <TextBlock x:Name="tbWellness" Text="Wellness" Margin="50, 0, 10, 0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                        Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pWellness" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbWellness" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pWellness" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbWellness" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                    <Border x:Name="bdrAnalytics">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
      BlurRadius="2"
      ShadowDepth="2"
      Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="btnToggleAnalytics"
       Height="40"
       Width="180"
       Checked="ToggleButton_Checked"
       Margin="0,25,0,0"
       FontSize="14"
       BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="border"
                                 CornerRadius="13"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}">
                                                        <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                    <Path x:Name="pAnalytics" Margin="25, 0, 10, 0" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}" HorizontalAlignment="Left"
                                      Data="M21,3V15.5A3.5,3.5 0 0,1 17.5,19A3.5,3.5 0 0,1 14,15.5A3.5,3.5 0 0,1 17.5,12C18.04,12 18.55,12.12 19,12.34V6.47L9,8.6V17.5A3.5,3.5 0 0,1 5.5,21A3.5,3.5 0 0,1 2,17.5A3.5,3.5 0 0,1 5.5,14C6.04,14 6.55,14.12 7,14.34V6L21,3Z"/>
                                                    <TextBlock x:Name="tbAnalytics" Text="Analytics" Margin="50, 0, 10, 0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                    Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pAnalytics" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbAnalytics" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pAnalytics" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbAnalytics" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                    <Border x:Name="bdrSelectPlaylist" Visibility="Hidden">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                              BlurRadius="2"
                              ShadowDepth="2"
                              Opacity="0.2"/>
                        </Border.Effect>
                        
                        <ToggleButton x:Name="btnToggleSelectPlaylist"
                           Height="40"
                           Width="180"
                           Margin="0,25,0,0"
                           Checked="ToggleButton_Checked"
                           FontSize="14"
                           BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="border"
                                                             CornerRadius="13"
                                                             Background="{TemplateBinding Background}"
                                                             BorderBrush="{TemplateBinding BorderBrush}">
                                                        <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"
                                                                          Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                    <Path x:Name="pPlaylists" Margin="25, 0, 10, 0" Width="15" Height="15" Stretch="Uniform"
                                                          Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}" HorizontalAlignment="Left"
                                                          Data="M15,6H3V8H15V6M15,10H3V12H15V10M3,16H11V14H3V16M17,6V14.18C16.69,14.07 16.35,14 16,14A3,3 0 0,0 13,17A3,3 0 0,0 16,20A3,3 0 0,0 19,17V8H22V6H17Z">
                                                    </Path>
                                                    <TextBlock x:Name="tbPlaylists" Text="Playlists" Margin="50, 0, 10, 0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                        Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    
                                                    <Trigger Property="IsPressed" Value="True">
                                                    </Trigger>
                                                    
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.PlaylistsToggleSelected.Brush}"/>
                                                        <Setter TargetName="pPlaylists" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbPlaylists" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>
              
                </StackPanel>

                <Border x:Name="bdrAIAssistant" Visibility="Visible">
                    <Border.Effect>
                        <DropShadowEffect Color="#B0B8C0"
                           BlurRadius="2"
                           ShadowDepth="2"
                           Opacity="0.4"/>
                    </Border.Effect>
                    <Button x:Name="Assistant"
                       Height="35"
                       Margin="0,25,0,0"
                       BorderBrush="Transparent"
                       VerticalAlignment="Bottom"
                       Click="NewPlaylist_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        </StackPanel>
                        
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{Binding CurrentTheme.WindowPrimary.Brush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontWeight" Value="Regular"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="border"
                                                        CornerRadius="13"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"/>
                                                </Border>
                                                <StackPanel x:Name="spNewPlaylist" Margin="-5, 0, 0, 0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path x:Name="pNewPlaylist" Margin="0, 3, 0, 0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Data ="M3 16H10V14H3M18 14V10H16V14H12V16H16V20H18V16H22V14M14 6H3V8H14M14 10H3V12H14V10Z"
                                                Fill="#1e1e1e" Stretch="Uniform"
                                                Width="16" Height="16"/>
                                            <TextBlock x:Name="tbNewPlaylist" Margin="10, 0, 0, 0" HorizontalAlignment="Left" Text="AI Assistant" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.NewPlaylistHover.Brush}"/>
                                                    <Setter TargetName="pNewPlaylist" Property="Fill" Value="White"/>
                                                    <Setter TargetName="tbNewPlaylist" Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Setter TargetName="pNewPlaylist" Property="Fill" Value="White"/>
                                                    <Setter TargetName="tbNewPlaylist" Property="Foreground" Value="White"/>
