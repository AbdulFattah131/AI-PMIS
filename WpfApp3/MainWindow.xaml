                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Style>
                    </ScrollViewer>
                </Border>

                <UserControl.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=btnToggleWellness}" Value="True">
                                <Setter Property="Visibility" Value="Visible"></Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=btnToggleWellness}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UserControl.Style>
            </UserControl>

            <UserControl x:Name="ucAnalyticsView" Grid.Column="1">

                <!-- Songs View -->

                <Border x:Name="bdCenterPanel5" CornerRadius="13" Background="{Binding CurrentTheme.PlayerControlBackground.Brush}" Margin="10, 10, 10, 15">
                    <Border.Effect>
                        <DropShadowEffect Color="{Binding CurrentTheme.ComplementGray.Brush}"
                      Direction="270"
                      ShadowDepth="4"
                      Opacity="0.18"
                      BlurRadius="8"/>
                    </Border.Effect>
                    <ScrollViewer Margin='0,10,10,10'>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <!-- AlbumsGrid -->
                            <Grid x:Name="grdTasks5" Grid.Row="1" Grid.ColumnSpan="2" Margin="40, 5, 40, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"></RowDefinition>
                                    <RowDefinition Height="9*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="tbDashboard5" Grid.Row="0" Text="Analytics Insights" FontSize="18" FontWeight="Black" 
                        Foreground="{Binding CurrentTheme.WindowHeadingForeground.Brush}" HorizontalAlignment="Left"/>

                                <TextBlock x:Name="tbPersonalOverview5" Grid.Row="1" Text="Track your progress across all modules" Margin="0,10,0,0" FontSize="13" FontWeight="Medium" 
                        Foreground="{Binding CurrentTheme.WindowHeadingForeground.Brush}" HorizontalAlignment="Left"/>
                                <!-- AlbumsListBox -->

                                <ListBox x:Name="lbAnalyticsCards" Height="200"
         Width="Auto"
         Grid.Column="0"
         Grid.Row="1"
         Margin="0,50,0,20"
         VerticalAlignment="Center"
         HorizontalAlignment="Left"
         BorderThickness="0"
         Background="Transparent">

                                    <!-- Horizontal panel -->
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <!-- Item template -->
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="175" Height="150" Margin="10" CornerRadius="15"
                    Background="{Binding DataContext.CurrentTheme.ListBoxItemBackground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                <Grid Margin="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Heading -->
                                                    <TextBlock Grid.Row="0" Text="{Binding}" FontWeight="Bold" FontSize="14"
                               Foreground="{Binding DataContext.CurrentTheme.WindowHeadingForeground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               HorizontalAlignment="Left"/>

                                                    <!-- Progress Bar -->
                                                    <ProgressBar Grid.Row="1" Height="12" Margin="0,20,0,0" Minimum="0" Maximum="100"
                                 Value="65"
                                                        Foreground="{Binding DataContext.CurrentTheme.ListBoxHover.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                 Background="{Binding DataContext.CurrentTheme.ListBoxItemBackground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>

                                                        <!-- Bottom value -->
                                                        <TextBlock Grid.Row="2" Text="0" FontWeight="Bold" FontSize="12"
                               Foreground="{Binding DataContext.CurrentTheme.CurrentSongArtistForeground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                    <!-- Static Items -->
                                    <ListBox.Items>
                                        <sys:String>Task Completion</sys:String>
                                        <sys:String>Monthly Balance</sys:String>
                                        <sys:String>Wellness Score</sys:String>
                                    </ListBox.Items>

                                    <!-- Item container style -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Margin" Value="0,0,15,0"/>
                                            <Setter Property="BorderBrush" Value="Gray"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15" BorderThickness="0.5" BorderBrush="Gray">
                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter TargetName="border" Property="Background" Value="{Binding DataContext.CurrentTheme.ListBoxHover.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="{Binding DataContext.CurrentTheme.ListBoxSelected.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                            </Grid>

                            <!-- AlbumContentsListBox (Songs) -->
                            <Grid x:Name="grdAlbumContents5" Grid.Row="2" Grid.ColumnSpan="2" Margin="40, 20, 40, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"></RowDefinition>
                                    <RowDefinition Height="4*"></RowDefinition>
                                    <RowDefinition Height="6*"></RowDefinition>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="1" Grid.Column="0" Margin="0, 10, 0, 0">

                                    <Button
                                    HorizontalAlignment="Right"
    Height="56"
Width="120"
    Margin="0,0,0,0"
    Content="Add Analytics"
    FontSize="14"
    FontWeight="SemiBold"
    HorizontalContentAlignment="Center"
    Padding="20,0"
Foreground="White"
    Background="Gray"
    BorderThickness="0"
    Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="14"
                Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Horizontal layout -->
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <!-- Search takes MOST space -->
                                                <ColumnDefinition Width="900" />
                                                <!-- Priority -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Status -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,0">

                                    <Border
                        CornerRadius="20"
                        Padding="16"
                        Height="200"
                    Width="1288"
                        HorizontalAlignment="Left"
                        Margin="0,45,0,0"
                        Background="Transparent"
                        BorderThickness="0.5"
                        BorderBrush="{Binding CurrentTheme.ComplementGray.Brush}">

                                        <StackPanel Orientation="Horizontal">


                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid x:Name="Root" Background="Transparent">
                                                <!-- Scroll content -->
                                                <ScrollContentPresenter />

                                                <!-- Custom vertical scrollbar -->
                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                           Orientation="Vertical"
                           Width="8"
                           Margin="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Background="Transparent"
                           Visibility="Collapsed"
                           Minimum="0"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{TemplateBinding VerticalOffset}"
                           SmallChange="16"
                           LargeChange="64">
                                                    <ScrollBar.Style>
                                                        <Style TargetType="ScrollBar">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ScrollBar">
                                                                        <Grid x:Name="ScrollRoot" Background="Transparent" Width="8">
                                                                            <Track x:Name="PART_Track" IsDirectionReversed="True">

                                                                                <!-- Hidden arrow buttons -->
                                                                                <Track.DecreaseRepeatButton>
                                                                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                                  Height="10"
                                                                  Visibility="Hidden"
                                                                  Background="Transparent"
                                                                  Focusable="False"
                                                                  BorderThickness="0"/>
                                                                                </Track.DecreaseRepeatButton>

                                                                                <!-- Rounded thumb -->
                                                                                <Track.Thumb>
                                                                                    <Thumb x:Name="Thumb" Visibility="Collapsed">
                                                                                        <Thumb.Template>
                                                                                            <ControlTemplate TargetType="Thumb">
                                                                                                <Border Background="#c0c0c0"
                                                                        CornerRadius="4"
                                                                        SnapsToDevicePixels="True"/>
                                                                                            </ControlTemplate>
                                                                                        </Thumb.Template>
                                                                                    </Thumb>
                                                                                </Track.Thumb>

                                                                                <Track.IncreaseRepeatButton>
                                                                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                                  Height="10"
                                                                  Visibility="Hidden"
                                                                  Background="Transparent"
                                                                  Focusable="False"
                                                                  BorderThickness="0"/>
                                                                                </Track.IncreaseRepeatButton>
                                                                            </Track>
                                                                        </Grid>

                                                                        <!-- Hover logic -->
                                                                        <ControlTemplate.Triggers>
                                                                            <!-- Show thumb when scrollbar hovered -->
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>

                                                                            <!-- Show thumb when track hovered -->
                                                                            <Trigger SourceName="PART_Track" Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>

                                                                            <!-- Show thumb when ScrollViewer (lyrics area) hovered -->
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                                                                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ScrollBar.Style>
                                                </ScrollBar>
                                            </Grid>

                                            <!-- Make scrollbar visible only on hover -->
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Style>
                    </ScrollViewer>
                </Border>

                <UserControl.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=btnToggleAnalytics}" Value="True">
                                <Setter Property="Visibility" Value="Visible"></Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=btnToggleAnalytics}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UserControl.Style>
            </UserControl>

        </Grid>


