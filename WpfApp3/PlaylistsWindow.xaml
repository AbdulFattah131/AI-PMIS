    <Window x:Class="MusicPlayer.UIComponents.PlaylistsWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="PlaylistsWindow" Width="1000" SizeToContent="Height">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Default Title Bar -->
            <DockPanel Grid.Row="0" Background="LightGray">
                <TextBlock Text="New Playlist" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
            </DockPanel>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Top Left: Playlists ListBox inside Border -->
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1"  CornerRadius="5" Padding="5" Margin="0,0,10,10">
                    <Grid>
                    <StackPanel>
                        <TextBlock Text="Your Playlists" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListBox Width="298" HorizontalAlignment="Left">
                            <ListBoxItem Content="Playlist 1"/>
                            <ListBoxItem Content="Playlist 2"/>
                            <ListBoxItem Content="Playlist 3"/>
                        </ListBox>
                        <ListBox x:Name="lbTemporaryPlaylist" ItemsSource="{Binding TemporarySongs}" Height="50" DisplayMemberPath="Title"/>

                    </StackPanel>
                   
                </Grid>
                </Border>

                <!-- Top Right: Selected Playlist ListBox inside Border -->
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1"  CornerRadius="5" Padding="5" Margin="0,0,0,10">
                    <StackPanel>
                    <Grid>
                    <TextBlock Text="All Songs" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Songs Selected" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SongCount}" FontWeight="Bold" Width="35" Margin="0,0,0,5"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="plSongsListBox" SelectionMode="Single" Width="630" Height="200" HorizontalAlignment="Left" ItemsSource="{Binding MusicPlayerCache.AllSongs}" SelectedItem="{Binding MusicPlayerCache.CurrentSong, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="90"/>

                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="{Binding Title}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Artist}" Margin="0,0,0,0" HorizontalAlignment="Left"/>
                                    <Button Grid.Column="3" x:Name="AddButton" Content="+" Width="25" Height="25" HorizontalAlignment="Center" Margin="0,0,10,0" Visibility="Visible" Click="AddButton_Click" ToolTip="Add Song"/>
                                    <Button Grid.Column="4" x:Name="RemoveButton" Content="-" Width="25" Height="25" HorizontalAlignment="Right" Visibility="Visible" Click="RemoveButton_Click" ToolTip="Remove Song"/>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </StackPanel>
                </Border>

                <!-- Bottom Left: Remove Playlist -->
            <Border Grid.Row="1" Grid.Column="0" VerticalAlignment="Stretch"
                    BorderBrush="Black" BorderThickness="1" CornerRadius="5"
                    Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Remove Playlist"
                   FontWeight="Bold" Margin="0,0,0,5"/>

                    <Button Grid.Row="1" Content="Remove Selected Playlist"
                HorizontalAlignment="Right" Margin="0,0,5,0" Width="150"/>
                </Grid>
            </Border>

            <!-- Bottom Right: Create and Save Playlist -->
            <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Stretch"
        BorderBrush="Black" BorderThickness="1" CornerRadius="5"
        Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Save Playlist"
                   FontWeight="Bold" Margin="0,0,0,5"/>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Grid.Row="1">
                        <TextBlock Text="Name" Margin="0,0,0,0"></TextBlock>
                        <TextBox Text="{Binding Path=NewPlaylist.Name, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="5,0,5,0"></TextBox>
                    
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="btnSavePlaylist" Content="Save Playlist" Width="150" Height="20"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        </Grid>
        

    </Window>
