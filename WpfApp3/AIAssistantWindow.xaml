<Window x:Class="MusicPlayer.UIComponents.AIAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Assistant" Width="1000" Height="600" ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <DockPanel Grid.Row="0" Background="#FF2D2D30">
            <TextBlock Text="AI Assistant" Foreground="White" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Commands / Suggestions -->
            <Border Grid.Column="0" Background="#FF1E1E1E" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Smart Suggestions" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,0,0,10"/>

                    <ListBox Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBoxItem IsHitTestVisible="False">
                            <TextBlock Text="Focus on High-Priority Tasks" Foreground="White"/>
                        </ListBoxItem>
                        <ListBoxItem IsHitTestVisible="False">
                            <TextBlock Text="Review Upcoming Meetings" Foreground="White"/>
                        </ListBoxItem>
                        <ListBoxItem IsHitTestVisible="False">
                            <TextBlock Text="Check Team Communications" Foreground="White"/>
                        </ListBoxItem>
                        <ListBoxItem IsHitTestVisible="False">
                            <TextBlock Text="Plan Your Work Sessions" Foreground="White"/>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Right Panel: AI Chat / Interaction -->
            <Border Grid.Column="1" Background="#FF252526" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat / AI output -->
                    <ScrollViewer Grid.Row="0" Background="#FF2D2D30" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel x:Name="spChatMessages" Orientation="Vertical">
                            <Border Background="#FF3E3E42" CornerRadius="5" Padding="8" Margin="0,0,0,10">
                                <TextBlock Text="AI: Hello! How can I assist you today?" Foreground="White" TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="#FF007ACC" CornerRadius="5" Padding="8" Margin="0,0,0,10" HorizontalAlignment="Right">
                                <TextBlock Text="You: Show me today's tasks" Foreground="White" TextWrapping="Wrap"/>
                            </Border>
                            <!-- More static messages can be added -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Input Box + Send Button -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBox x:Name="txtUserInput" Width="700" Height="30" Margin="0,0,10,0" 
                                 Background="#FF3E3E42" Foreground="White" BorderThickness="0" Padding="5"
                                 Text="Type your command..." />
                        <Button Content="Send" Width="100" Height="30" Background="#FF007ACC" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
